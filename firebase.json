{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "tools/**",
      "release/**",
      "**/*.apk",
      "**/*.aab",
      "**/*.log"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=600" }]
      }
    ]
  }
}
